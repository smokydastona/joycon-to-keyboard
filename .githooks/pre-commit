#!/bin/sh
# Mandatory UI artifact generation.
#
# - Ensures docs/ui/{default,dark}/backgrounds/ images exist.
# - Ensures .ui-bundle/ exists (ignored by git) for local runs.
#
# If tracked files are generated/updated, they are auto-staged.

set -e

PY=""
PY_ARGS=""

# Prefer the repo venv if present so UI artifacts are generated with pinned deps
# (avoids churn across machines with different global Pillow versions).
if [ -x "./.venv/Scripts/python.exe" ]; then
  PY="./.venv/Scripts/python.exe"
elif command -v py >/dev/null 2>&1; then
  PY="py"
  PY_ARGS="-3"
elif command -v python >/dev/null 2>&1; then
  PY="python"
else
  echo "[pre-commit] python/py not found; cannot generate mandatory UI artifacts" >&2
  exit 1
fi

"$PY" $PY_ARGS tools/versioning.py write-repo-version --output version.json --next-commit
"$PY" $PY_ARGS tools/versioning.py write-app-version --repo-version version.json --output helper-app/joycon_helper/_version.py
"$PY" $PY_ARGS tools/generate_ui_artifacts.py

# Stage the auto-incremented repo version file and app version.
git add version.json 2>/dev/null || true
git add helper-app/joycon_helper/_version.py 2>/dev/null || true

# Stage composited backgrounds and button overlays if they changed.
git add -A docs/ui/default/backgrounds/ docs/ui/dark/backgrounds/ 2>/dev/null || true
git add -A docs/ui/button_overlays/ 2>/dev/null || true
