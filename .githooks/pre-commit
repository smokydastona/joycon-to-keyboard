#!/bin/sh
# Mandatory UI artifact generation.
#
# - Ensures docs/ui/assets/joycons-{left,right,both}.png exist (inspection copies).
# - Ensures .ui-bundle/ exists (ignored by git) for local runs.
#
# If tracked files are generated/updated, they are auto-staged.

set -e

if command -v py >/dev/null 2>&1; then
  py -3 tools/generate_ui_artifacts.py
elif command -v python >/dev/null 2>&1; then
  python tools/generate_ui_artifacts.py
else
  echo "[pre-commit] python/py not found; cannot generate mandatory UI artifacts" >&2
  exit 1
fi

# Stage the inspection copies if they exist/changed.
git add -A docs/ui/assets/joycons-none.png docs/ui/assets/joycons-left.png docs/ui/assets/joycons-right.png docs/ui/assets/joycons-both.png 2>/dev/null || true
