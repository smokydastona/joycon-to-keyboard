#!/bin/sh
# Validate that UI artifacts are up-to-date before push.
# The pre-commit hook already generates and stages them, so this only
# checks for unexpected dirty state.
set -e

# If tracked overlay/background files are dirty, abort the push so
# the developer can commit them first.
if git diff --name-only HEAD -- docs/ui/ | grep -q .; then
  echo "[pre-push] docs/ui/ has uncommitted changes — run 'git add -A docs/ui/ && git commit --amend' first." >&2
  exit 1
fi
