#!/bin/sh
# Mandatory UI artifact generation before push.
set -e

if command -v py >/dev/null 2>&1; then
  py -3 tools/generate_ui_artifacts.py
elif command -v python >/dev/null 2>&1; then
  python tools/generate_ui_artifacts.py
else
  echo "[pre-push] python/py not found; cannot generate mandatory UI artifacts" >&2
  exit 1
fi
