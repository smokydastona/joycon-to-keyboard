# ESP32 Classic-BT Host — sdkconfig overrides.

# Flash size — partition table requires ~3.6 MB (two OTA app slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA-enabled partition table (two app slots + NVS + OTA data).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable app rollback — new OTA firmware must call
# esp_ota_mark_app_valid_cancel_rollback() or the bootloader
# reverts to the previous partition on next reboot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 1 kHz tick rate for 1ms task delays (low-latency input processing).
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth Classic (BR/EDR) HID Host ---
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# --- Joy-Con report parsing and key emitting ---
# Proven safe: setup FSM confirms Joy-Con (L), type=1, fw=3.139.
# 0x30 reports are standard Nintendo full-input format.
CONFIG_JOYCON_HOST_TRY_NINTENDO_0X30=y
CONFIG_JOYCON_HOST_NINTENDO_0X30_EMIT_KEYS=y
