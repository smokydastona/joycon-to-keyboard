# Enable USB CDC-ACM (serial / COM port) alongside HID.
# This file is applied by ESP-IDF when generating sdkconfig.

CONFIG_TINYUSB_CDC_ENABLED=y

# Disable the default UART0 console.  The bridge UART now uses GPIO5/6
# (Nano D2/D3) which are free of UART0 conflicts, but disabling the
# console is still recommended to avoid any I/O MUX contention and to
# save resources.
CONFIG_ESP_CONSOLE_NONE=y

# Two HID interface instances: keyboard (instance 0) + mouse (instance 1).
# NOTE: Gamepad (instance 2) temporarily removed for enumeration diagnosis.
CONFIG_TINYUSB_HID_COUNT=2

# Flash size — partition table requires ~3.6 MB (two OTA app slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA-enabled partition table (two app slots + NVS + OTA data).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable app rollback — new OTA firmware must call
# esp_ota_mark_app_valid_cancel_rollback() or the bootloader
# reverts to the previous partition on next reboot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 1 kHz tick rate for 1ms task delays (low-latency input processing).
CONFIG_FREERTOS_HZ=1000

# Task watchdog — resets if any subscribed task starves for 10 s.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
