# Enable USB CDC-ACM (serial / COM port) alongside HID.
# This file is applied by ESP-IDF when generating sdkconfig.

CONFIG_TINYUSB_CDC_ENABLED=y

# Ensure at least one HID interface instance exists.
CONFIG_TINYUSB_HID_COUNT=1

# Flash size — partition table requires ~3.6 MB (two OTA app slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA-enabled partition table (two app slots + NVS + OTA data).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable app rollback — new OTA firmware must call
# esp_ota_mark_app_valid_cancel_rollback() or the bootloader
# reverts to the previous partition on next reboot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
