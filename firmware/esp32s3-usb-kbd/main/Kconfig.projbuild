menu "Bind Bandit (ESP32-S3 USB Keyboard)"

config BRIDGE_UART_PORT
    int "UART port" 
    range 0 2
    default 1
    help
        UART peripheral number used to receive frames from the Joy-Con receiver.

config BRIDGE_UART_BAUD
    int "Bridge UART baud"
    default 921600

config BRIDGE_UART_TX_GPIO
    int "Bridge UART TX GPIO"
    default 6
    help
        GPIO used for UART TX (Nano ESP32 D3 = GPIO6).

config BRIDGE_UART_RX_GPIO
    int "Bridge UART RX GPIO"
    default 5
    help
        GPIO used for UART RX (Nano ESP32 D2 = GPIO5). Connect to Joy-Con receiver TX.

endmenu
